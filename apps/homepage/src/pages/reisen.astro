---
import Layout from '../layouts/Layout.astro';
import { translations, type Language } from '../i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const t = translations(lang);
const feed = '/api/public/reports/rss' + (lang === 'en' ? '?lang=en' : '');
---
<Layout title={t('Reiseberichte', 'Travel reports')} lang={lang}>
  <h1>{t('Reiseberichte', 'Travel reports')}</h1>
  <p>{t('Neue Orte, kleine Abenteuer und Erinnerungen.', 'New places, little adventures and memories.')} <a href={feed}>{t('Reiseberichte als RSS-Feed abonnieren', 'Subscribe to travel reports via RSS')}</a></p>
  <p id="reports-status" role="status">{t('Reiseberichte werden geladen ...', 'Loading travel reports ...')}</p>
  <div id="reports-list" class="cards"></div>
  <div class="pagination">
    <button id="reports-previous" type="button" disabled>{t('Vorherige Seite', 'Previous page')}</button>
    <span id="reports-page"></span>
    <button id="reports-next" type="button" disabled>{t('Naechste Seite', 'Next page')}</button>
    <button id="reports-retry" type="button" hidden>{t('Erneut versuchen', 'Try again')}</button>
  </div>
  <noscript><p>{t('Fuer die aktuelle Berichtsliste bitte JavaScript aktivieren oder diesen Feed verwenden:', 'Please enable JavaScript for the current report list or use this feed:')} <a href={feed}>RSS</a>.</p></noscript>
</Layout>
<script>
  import { loadReportList } from '../scripts/reports';
  loadReportList();
</script>
