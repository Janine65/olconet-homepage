---
import Layout from '../layouts/Layout.astro';
import { translations, type Language } from '../i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const t = translations(lang);
---
<Layout title={t('Kontakt', 'Contact')} lang={lang}>
  <h1>{t('Kontakt', 'Contact')}</h1>
  <p>{t('Schreib mir an', 'Write to me at')} <a href="mailto:janine@olconet.com">janine@olconet.com</a>.</p>
  <p>{t('Das Kontaktformular mit Mailversand und Spam-Schutz folgt. Aktuell werden auf dieser Seite keine Nachrichten entgegengenommen.',
    'A contact form with email delivery and spam protection is planned. This page does not currently accept messages.')}</p>
</Layout>
