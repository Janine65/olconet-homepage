---
import Layout from '../layouts/Layout.astro';
import { pagePath, translations, type Language } from '../i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const t = translations(lang);
---
<Layout title={t('Kontakt', 'Contact')} description={t('Schreibe Janine eine Nachricht über das Kontaktformular oder per E-Mail.', 'Send Janine a message using the contact form or by email.')} lang={lang}>
  <h1>{t('Kontakt', 'Contact')}</h1>
  <p>{t('Du kannst mir auch direkt per E-Mail schreiben:', 'You can also email me directly:')} <a href="mailto:janine@olconet.com">janine@olconet.com</a>.</p>
  <p class="form-note">{t('Hinweise zur Verarbeitung deiner Daten und zu Cloudflare Turnstile stehen in der', 'See the')}
    <a href={pagePath('/datenschutz/', lang)}>{t('Datenschutzerklärung', 'privacy notice')}</a>{t('.', ' for details on how your data is handled and how Cloudflare Turnstile is used.')}</p>
  <form id="contact-form">
    <fieldset disabled>
      <label for="contact-name">{t('Name', 'Name')}</label>
      <input id="contact-name" name="name" autocomplete="name" required maxlength="100" />
      <label for="contact-email">{t('E-Mail-Adresse', 'Email address')}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
      <label for="contact-message">{t('Nachricht', 'Message')}</label>
      <textarea id="contact-message" name="message" rows="7" required maxlength="5000"></textarea>
      <div data-turnstile-widget></div>
      <button type="submit" disabled>{t('Nachricht senden', 'Send message')}</button>
    </fieldset>
    <p data-contact-status role="status" aria-live="polite">
      {t('Das Formular wird geladen …', 'Loading the contact form …')}
    </p>
  </form>
</Layout>
<script>
  import '../scripts/contact';
</script>
<style>
  form { display: grid; gap: 1rem; max-width: 700px; }
  fieldset { display: grid; gap: .75rem; border: 0; padding: 0; margin: 0; }
  input, textarea { width: 100%; padding: .8rem; border: 1px solid #8a9e93; border-radius: .4rem; font: inherit; }
  textarea { resize: vertical; }
  button { font: inherit; padding: .7rem 1rem; border: 1px solid #245e50; border-radius: .4rem; color: #fff; background: #245e50; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  [data-contact-status] { min-height: 1.5em; }
  .form-note { font-size: .9rem; color: #53665f; }
</style>
