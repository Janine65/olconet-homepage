---
import Layout from '../../layouts/Layout.astro';
import { translations, pagePath, type Language } from '../../i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const t = translations(lang);
---
<Layout title={t('Reisebericht', 'Travel report')} lang={lang}>
  <a href={pagePath('/reisen/', lang)}>{t('Zurueck zu den Reiseberichten', 'Back to travel reports')}</a>
  <p id="report-status" role="status">{t('Reisebericht wird geladen ...', 'Loading travel report ...')}</p>
  <article id="report-article" hidden>
    <h1 id="report-title"></h1>
    <p id="report-meta"></p>
    <p id="report-excerpt"></p>
    <section id="report-page" data-photo-group>
      <h2 id="report-page-title" tabindex="-1"></h2>
      <div id="report-content" class="report-content"></div>
      <section id="report-gallery" class="report-gallery" aria-label={t('Bildergalerie dieser Berichtsseite', 'Photo gallery for this report page')} hidden></section>
    </section>
    <nav id="report-page-navigation" class="pagination" aria-label={t('Seiten des Reiseberichts', 'Travel report pages')} hidden>
      <a id="report-page-previous" hidden>{t('Vorherige Seite', 'Previous page')}</a>
      <span id="report-page-position" role="status"></span>
      <label for="report-page-select">{t('Seite waehlen', 'Choose a page')}</label>
      <select id="report-page-select"></select>
      <a id="report-page-next" hidden>{t('Naechste Seite', 'Next page')}</a>
    </nav>
  </article>
  <button id="report-retry" type="button" hidden>{t('Erneut versuchen', 'Try again')}</button>
  <noscript><p>{t('Zum Lesen dieses Berichts bitte JavaScript aktivieren.', 'Please enable JavaScript to read this report.')}</p></noscript>
</Layout>
<script>
  import { loadReport } from '../../scripts/reports';
  loadReport();
</script>
