---
import Layout from '../layouts/Layout.astro';
import { translations, pagePath, type Language } from '../i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const t = translations(lang);
---
<Layout title={t('Willkommen', 'Welcome')} lang={lang}>
  <p class="eyebrow">{t('Reisen', 'Travel')} &middot; {t('Kreativ sein', 'Creativity')} &middot; {t('Mit Sammy unterwegs', 'Adventures with Sammy')}</p>
  <h1>{t('Momente sammeln. Geschichten teilen.', 'Collecting moments. Sharing stories.')}</h1>
  <p>{t('Willkommen auf meiner persoenlichen Homepage. Hier entsteht ein Ort fuer meine Reiseberichte, kreativen Arbeiten und Erlebnisse mit Sammy.',
    'Welcome to my personal homepage. A place for my travel reports, creative work and adventures with Sammy.')}</p>
  <div class="cards">
    <section class="card"><h2>{t('Reiseberichte', 'Travel reports')}</h2><p>{t('Neue Orte, kleine Abenteuer und Erinnerungen.', 'New places, little adventures and memories.')}</p><a href={pagePath('/reisen/', lang)}>{t('Zu den Reisen', 'Explore my travels')}</a></section>
    <section class="card"><h2>{t('Meine Kreationen', 'My creations')}</h2><p>{t('Zeichnungen, Toepferarbeiten, Naehprojekte und mehr.', 'Drawings, pottery, sewing projects and more.')}</p><a href={pagePath('/kreationen/', lang)}>{t('Zur Galerie', 'View the gallery')}</a></section>
    <section class="card"><h2>Sammy</h2><p>{t('Einblicke in das Leben mit meinem Hund.', 'A glimpse into life with my dog.')}</p><a href={pagePath('/sammy/', lang)}>{t('Zu Sammy', 'Meet Sammy')}</a></section>
  </div>
</Layout>
