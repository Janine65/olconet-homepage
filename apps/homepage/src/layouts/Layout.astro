---
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Janines Reiseberichte, kreative Arbeiten und Fotos von Sammy." />
    <title>{title} | olconet</title>
    <link rel="alternate" type="application/rss+xml" title="olconet Reiseberichte" href="/api/public/reports/rss" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">olconet</a>
      <nav aria-label="Hauptnavigation">
        <a href="/reisen/">Reisen</a>
        <a href="/kreationen/">Meine Kreationen</a>
        <a href="/sammy/">Sammy</a>
        <a href="/kontakt/">Kontakt</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>olconet &middot; Janines persoenliche Homepage</footer>
  </body>
</html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #243b36; background: #faf8f3; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header, main, footer { max-width: 1100px; margin: auto; padding: 1.5rem; }
  header { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; align-items: center; }
  a { color: #245e50; text-underline-offset: .2em; }
  .brand { font-size: 1.8rem; font-weight: 750; text-decoration: none; }
  nav { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  main { min-height: 70vh; padding-top: 4rem; }
  h1 { font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: 1.1; max-width: 850px; }
  p { line-height: 1.7; max-width: 700px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .15em; font-size: .85rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1.5rem; margin-top: 3rem; }
  .card { padding: 1.5rem; border: 1px solid #d4ddd4; border-radius: 1rem; background: white; }
  footer { font-size: .9rem; color: #53665f; border-top: 1px solid #d4ddd4; }
  button { font: inherit; padding: .6rem 1rem; border: 1px solid #245e50; border-radius: .4rem; color: #245e50; background: white; cursor: pointer; }
  button:disabled { opacity: .5; cursor: default; }
  .pagination { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-top: 2rem; }
  .report-content { max-width: 800px; line-height: 1.7; overflow-wrap: anywhere; }
  .report-content blockquote { border-left: 3px solid #8a9e93; padding-left: 1rem; margin-left: 0; }
  .report-content figure { margin: 1.5rem 0; }
  .report-content img, .report-gallery img { max-width: 100%; max-height: 700px; object-fit: contain; }
  .report-content figcaption, .report-gallery figcaption { color: #53665f; line-height: 1.6; overflow-wrap: anywhere; }
  .report-gallery:not([hidden]) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; margin-top: 2rem; }
  .report-gallery figure { margin: 0; padding: 1rem; background: white; border: 1px solid #d4ddd4; }
  .report-gallery img { width: 100%; height: 300px; }
</style>
