DOCKER_PLATFORM=linux/amd64
# Fuer Registry-Transfer z.B. registry.example.com/olconet verwenden.
IMAGE_PREFIX=janine65
IMAGE_TAG=latest
ADMIN_ORIGIN=https://verwaltung.example.com
# Muss exakt der Browser-Origin der Homepage entsprechen (inkl. www, ohne Slash).
SITE_URL=https://www.example.com
# Besucheranalyse: alle drei Proxy-Werte setzen, sonst bleibt die Erfassung deaktiviert.
# Secret lokal erzeugen: openssl rand -hex 32
VISITOR_PROXY_SECRET=
# Unmittelbare Proxy-IP, wie sie im Homepage-Container sichtbar ist.
VISITOR_TRUSTED_PROXIES=192.168.1.200
# Oeffentliche Heimnetz-IP(s), kommasepariert; keine private LAN-IP.
VISITOR_EXCLUDED_IPS=
# GeoLite2 Country MMDB-Datei (kein rohes Besuchs-IP-Logging).
GEOIP_DATA_DIR=/volume1/server/olconet/geoip
GEOIP_COUNTRY_DB=/geoip/GeoLite2-Country.mmdb
# Turnstile-Site-Key ist öffentlich; Secret-Key und SMTP-Zugangsdaten geheim halten.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_RECIPIENT=janine@olconet.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Vorhandener PostgreSQL-Container im externen Docker-Netzwerk back-tier.
# Datenbank und Benutzer vorher anlegen. URL-Passwort ggf. percent-encodieren.
DATABASE_URL=postgresql://olconet:CHANGE_ME@postgres_server:5432/olconet?schema=webpage
