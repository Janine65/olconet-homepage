DOCKER_PLATFORM=linux/amd64
# Fuer Registry-Transfer z.B. registry.example.com/olconet verwenden.
IMAGE_PREFIX=janine65
IMAGE_TAG=latest
ADMIN_ORIGIN=https://verwaltung.example.com
SITE_URL=https://olconet.com
# Vorhandener PostgreSQL-Container im externen Docker-Netzwerk back-tier.
# Datenbank und Benutzer vorher anlegen. URL-Passwort ggf. percent-encodieren.
DATABASE_URL=postgresql://olconet:CHANGE_ME@postgres_server:5432/olconet?schema=webpage
